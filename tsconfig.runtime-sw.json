{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "WebWorker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": false
  },
  "include": [
    "src/runtime-sw.ts",
    "src/lib/capsule/open/runtimeBridge.ts",
    "src/lib/capsule/open/runtimeBridgeReadRange.ts",
    "src/lib/capsule/open/runtimeRegistry.ts",
    "src/lib/capsule/open/runtimeMessages.ts",
    "src/lib/capsule/open/openTypes.ts",
    "src/types/vault.ts",
    "src/types/manifest.ts",
    "src/lib/storage/storageAdapter.ts",
    "src/lib/crypto/validators.ts"
  ]
}
