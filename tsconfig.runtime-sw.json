{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "target": "ES2021",

    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": [
      "ES2021",
      "WebWorker"
    ],

    "types": [],

    "strict": true,

    "noEmit": true,

    "isolatedModules": true,

