# ================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ================================
# Editor / IDE
# ================================

.vscode/
.idea/
tsconfig.vscode.json


# ================================
