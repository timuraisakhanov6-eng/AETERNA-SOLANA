```dotenv
# ======================================================
# AETERNA — Environment Variables (EXAMPLE)
# ======================================================
# ⚠️ DO NOT PUT REAL SECRETS HERE
# This file is safe to commit.
# Copy to `.env.local` and fill real values there.
# ======================================================


# ======================================================
# Web3 (Base Mainnet)
# ======================================================

# Alchemy RPC endpoint for Base Mainnet
#
# Used ONLY by backend to:
# - verify USDC transactions
# - check transaction status
# - read on-chain data
#
# ❌ NOT used for:
# - cryptography
# - sealing
# - key derivation
#
# Where to get:
# Alchemy Dashboard →
#   App → Node RPC Setup →
#   Network: Base Mainnet →
#   "Endpoint URL"
#
# Example (DO NOT paste here):
# https://base-mainnet.g.alchemy.com/v2/XXXXXXXX
#
ALCHEMY_BASE_URL=


# ======================================================
# Paddle (Fiat payments — Merchant of Record)
# ======================================================

# Paddle environment
# Possible values:
# - sandbox
# - live
#
PADDLE_ENV=sandbox


# Paddle API key (server-side only)
#
# Used by backend to:
# - verify completed transactions
# - validate payment status
#
# ❌ NEVER exposed to frontend
#
# Where to get:
# Paddle Dashboard →
#   Developer Tools → API Keys
#
PADDLE_API_KEY=


# Paddle Webhook Secret
#
# Used to verify Paddle webhooks authenticity
#
# Where to get:
# Paddle Dashboard →
#   Developer Tools → Webhooks
#
PADDLE_WEBHOOK_SECRET=


# ======================================================
# Trusted Time (optional, guard-only)
# ======================================================

# Trusted UTC time endpoint
#
# Used ONLY to:
# - prevent sealing in the past
# - prevent opening before openAt
#
# ❌ NOT used for:
# - encryption
# - sealing
# - key derivation
#
# DEV:
#   Leave empty → Date.now() is used
#
# PROD:
#   Your own API endpoint, e.g.:
#   https://your-domain.com/api/time
#
TIME_API_URL=
```