/*/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.paddle.com https://sandbox-cdn.paddle.com https://sandbox-checkout-service.paddle.com; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com https://checkout.paddle.com https://sandbox-checkout.paddle.com https://sandbox-checkout-service.paddle.com; connect-src 'self' https://api.paddle.com https://sandbox-api.paddle.com https://sandbox-checkout-service.paddle.com https://sandbox-checkout.paddle.com https://node1.irys.xyz https://node2.irys.xyz https://gateway.irys.xyz https://arweave.net https://permaweb.eu https://arweave.live; img-src 'self' data: blob: https://cdn.paddle.com https://api.qrserver.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none';


/index.html
  Cache-Control: no-cache, no-store, must-revalidate


/emergency.html
  Cache-Control: no-cache, no-store, must-revalidate


/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff


/capsule/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow